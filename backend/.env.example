# =============================================================================
# GeoAgentic Environment Configuration
# =============================================================================

# Google Cloud Routes API Key (Optional)
# Enables dual-engine hybrid routing with Google Routes API.
# If not provided or quota-exceeded, automatically falls back to offline OSMnx.
ROUTE_API_KEY=your_google_routes_api_key_here

# Database URL (Optional)
# Defaults to persistent SQLite at backend/geoagentic.db.
# Set DATABASE_URL to a custom SQLite URL or to PostgreSQL with its SQLAlchemy driver installed.
# Example: DATABASE_URL=sqlite:///geoagentic.db
# DATABASE_URL=postgresql://user:password@localhost:5432/geoagentic
